# Copie para .env e ajuste. O .env NUNCA deve ser versionado.

# --- Django ------------------------------------------------------------------
# SECRET_KEY é obrigatória quando DEBUG=False: a aplicação se recusa a subir sem
# ela. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# DEBUG é False por padrão. Ligue explicitamente APENAS em desenvolvimento.
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados ----------------------------------------------------------
# Em produção use DATABASE_URL (PostgreSQL). O fallback para SQLite existe
# somente para desenvolvimento local.
DATABASE_URL=
USE_SQLITE_FALLBACK=true

# Alternativa ao DATABASE_URL, com variáveis individuais:
# POSTGRES_DB=mxodontologia
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

RENDER_EXTERNAL_HOSTNAME=

# --- E-mail (recuperação de senha e credenciais de pacientes) ----------------
# Deixe em branco para usar o "console backend" (e-mails saem no terminal).
# Para Gmail: ative a verificação em duas etapas e gere uma "senha de app"
# em https://myaccount.google.com/apppasswords — NÃO use a senha normal da conta.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Bloqueio de login -------------------------------------------------------
# Tentativas são contadas por (IP, usuário) dentro da janela abaixo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_ATTEMPT_RETENTION_DAYS=90

# --- Observabilidade ---------------------------------------------------------
LOG_LEVEL=INFO
